{
  "name": "lorca",
  "private": true,
  "version": "1.0.29",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "release": "bun run scripts/release.ts",
    "release-ios": "bun run scripts/release-ios.ts",
    "release-android": "bun run scripts/release-android.ts",
    "desktop": "bun run scripts/desktop.ts",
    "desktop:build": "bun run scripts/desktop.ts build",
    "release-desktop": "bun run scripts/desktop.ts release",
    "cli": "cargo run -q -p lorca -- serve",
    "reset": "bun run scripts/reset.ts",
    "clean:rust": "bun run scripts/clean-rust.ts",
    "relay": "mkdir -p temp && cargo run -q -p lorca-relay -- --bind 0.0.0.0:8787 --db temp/lorca-relay.db --apns-topic app.lorca.dev",
    "l10n": "bun run scripts/l10n.ts",
    "phone-icons": "bun run scripts/phone-icons.ts",
    "check:docs": "bun run scripts/check-docs.ts",
    "check:catalog": "bun run scripts/check-catalog.ts",
    "web": "bun run --cwd web dev",
    "web:build": "bun run --cwd web build",
    "web:deploy": "bun run --cwd web deploy",
    "mobile:dev": "bun run scripts/mobile.ts",
    "mobile:phone": "bun run scripts/mobile.ts --phone",
    "android": "bun run --cwd mobile core android && LORCA_MOBILE_VARIANT=development bun run --cwd mobile android"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
